# DadoSabedoria — variáveis de ambiente (12-factor). Copie para `.env` e troque os segredos.
# NUNCA commite o `.env` (está no .gitignore). Segredo nunca no código (invariante 8).
#
# Isolamento de PII (§8.1): apesar de CONSENT_DATABASE_URL/APP_FIELD_KEY existirem aqui, o
# docker-compose só os entrega ao migrator e ao serviço de consentimento — api/worker/ai NÃO os
# recebem (teste estático no CI garante).

# === Banco — superusuário (somente migrator) ===
# POSTGRES_PASSWORD e a senha em ADMIN_DATABASE_URL DEVEM coincidir.
POSTGRES_PASSWORD=change_me_admin
ADMIN_DATABASE_URL=postgresql+asyncpg://postgres:change_me_admin@db:5432/dadosabedoria

# === Banco — role analítica (api/worker/ai). Sem acesso ao schema app. ===
# A migração 0009 cria a role com ESTE nome/senha (a DSN é a fonte única).
DATABASE_URL=postgresql+asyncpg://role_analitica:change_me_analitica@db:5432/dadosabedoria

# === Banco — role de consentimento (SÓ o serviço de consentimento). Única com acesso ao app. ===
CONSENT_DATABASE_URL=postgresql+asyncpg://role_consentimento:change_me_consent@db:5432/dadosabedoria
# Chave de cifragem em nível de campo do schema app (distinta do acervo analítico).
APP_FIELD_KEY=change_me_field_key

# === Cache / eventos ===
REDIS_URL=redis://redis:6379/0

# === Segurança / gateway ===
# JWT do cidadão (consentimento): use uma chave LONGA (>= 32 bytes).
JWT_SECRET=change_me_jwt_use_uma_chave_longa_de_pelo_menos_32_bytes
CORS_ORIGINS=http://localhost:3000
# Para TLS em produção (Traefik ACME): defina domínio + e-mail e habilite em infra/traefik.
PUBLIC_DOMAIN=
ACME_EMAIL=

# === Backup / DR (runbook docs/runbooks/backup-restore.md) ===
# Cifra o dump de PII (schema app) em repouso (gpg AES256). Use uma passphrase LONGA e guarde-a
# no gestor de segredos — SEM ela o backup de PII é irrecuperável. NÃO é a APP_FIELD_KEY.
BACKUP_PASSPHRASE=change_me_backup_passphrase_longa
# Retenção por classe: PII curta (minimização LGPD), acervo analítico mais longa.
ANALYTIC_RETENTION_DAYS=30
APP_RETENTION_DAYS=7

# === Object storage (MinIO) — usado só com a ingestão (profile `ingestion`) ===
S3_ENDPOINT=http://minio:9000
S3_KEY=change_me_minio
S3_SECRET=change_me_minio_secret
S3_BUCKET_BRONZE=bronze

# === IA (fronteira; placeholder até a fatia de IA) ===
LLM_API_KEY=

# === Observabilidade (profile `observability`) ===
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=admin
